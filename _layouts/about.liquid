---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="container">
    <div class="row">
    {% if page.profile %}
      <div class="col-md-4 p-0 mr-3 profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid rounded' %}
          {% endif %}
          {% comment %} Over-report the slot width so browsers pick the 800/1400px variants
          (the 480px one looks soft on Retina screens for a portrait). {% endcomment %}
          {% capture sizes %}(min-width: 576px) 520px, 95vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}


      <!-- Social -->
      {% if page.social %}
        <div class="social">
          <div class="contact-icons">{% include social.liquid %}</div>

          <div class="contact-note">{{ site.contact_note }}</div>
        </div>
      {% endif %}

      <!-- Affiliations -->
      {% if page.affiliations %}
        <div class="affiliations">
          {% for aff in page.affiliations %}
            <a href="{{ aff.url }}" title="{{ aff.name }}" target="_blank" rel="noopener">
              <img src="{{ aff.logo_light | relative_url }}" class="only-light" alt="{{ aff.name }}">
              <img src="{{ aff.logo_dark | relative_url }}" class="only-dark" alt="{{ aff.name }}">
            </a>
          {% endfor %}
        </div>
      {% endif %}
      </div>
    {% endif %}

    <div class="col-md p-0 clearfix" style="text-align: justify;">{{ content }}</div>
    </div>
    </div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="section-title">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2 class="section-title">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="section-title">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Selected projects -->
    {% if page.selected_projects %}
      <h2 class="section-title">
        <a href="{{ '/projects/' | relative_url }}" style="color: inherit">Selected Projects</a>
      </h2>
      {% include selected_projects.liquid %}
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
